# Copy to .env and fill in. Used by apps/server, apps/client and packages/db (via dotenvx).

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# docker compose exposes Postgres on 5435
DATABASE_URL=postgresql://local:local@127.0.0.1:5435/classroom
# Optional: max connections per API process (default 10)
DATABASE_POOL_MAX=10

# ── API (apps/server) ───────────────────────────────────────────────────────
# Secret for signing JWTs. Also the salt of legacy password hashes — do not
# change it on an existing database until every user has logged in once.
ENTROPY=
PORT=4000
# Comma-separated list of browser origins allowed by CORS / socket.io
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared secret the Discord / assignment bots send in the x-bot-secret header.
# Required when NODE_ENV=production. Must match BOT_API_SECRET in both bot .env files.
BOT_API_SECRET=
# Optional: school assigned to self-registered users (defaults to the oldest school)
DEFAULT_SCHOOL_ID=

SLIP_VERIFY_CLIENT_ID=
SLIP_VERIFY_CLIENT_SECRET=

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ── Web client (apps/client) ────────────────────────────────────────────────
NEXT_PUBLIC_ENDPOINT=http://127.0.0.1:4000
# Assignment bot (FastAPI)
NEXT_PUBLIC_API_8000=http://127.0.0.1:8000
NEXT_PUBLIC_FILE_ENDPOINT=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
