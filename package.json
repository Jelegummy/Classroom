{
  "name": "@app/monorepo",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "dotenvx run -- turbo dev  --filter=\"!./apps/assignment-bot\"",
    "dev:aong": "dotenvx run -- turbo dev --filter=\"!./apps/bot\"",
    "dev:client": "dotenvx run -- turbo dev --filter=\"./apps/client\"",
    "dev:server": "dotenvx run -- turbo dev --filter=\"./apps/server\"",
    "build": "dotenvx run -- turbo build",
    "build:package": "dotenvx run -- turbo build --filter=\"./packages/*\"",
    "start": "dotenvx run -- turbo start --filter=\"!./apps/assignment-bot\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "fmt": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:push": "dotenvx run -- pnpm --filter=@app/db push",
    "db:studio": "dotenvx run -- pnpm --filter=@app/db studio",
    "db:generate": "dotenvx run -- pnpm --filter=@app/db generate",
    "db:migrate:dev": "dotenvx run -- pnpm --filter=@app/db migrate:dev",
    "db:migrate:draft": "dotenvx run -- pnpm --filter=@app/db migrate:draft",
    "db:migrate:deploy": "dotenvx run -- pnpm --filter=@app/db migrate:deploy",
    "db:migrate:reset": "dotenvx run -- pnpm --filter=@app/db migrate:reset",
    "typecheck": "turbo typecheck",
    "db:seed": "dotenvx run -- pnpm --filter=@app/db seed",
    "db:migrate:resolve": "dotenvx run -- pnpm --filter=@app/db migrate:resolve",
    "test:e2e": "dotenvx run -- node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.75.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.16.22",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.7.4",
    "rimraf": "6.1.4",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.12.4",
  "prettier": {
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "semi": false,
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "pnpm": {
    "neverBuiltDependencies": []
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
