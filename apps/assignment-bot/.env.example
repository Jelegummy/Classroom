# AI homework-checking service (FastAPI). Copy to .env and fill in.

# Local: docker compose exposes Postgres on 5435.
# (docker compose overrides this with db:5432 inside the container network.)
DATABASE_URL=postgresql://local:local@127.0.0.1:5435/classroom

NESTJS_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Must equal BOT_API_SECRET of the API (root .env)
BOT_API_SECRET=

# Typhoon LLM (question generation, answer keys, grading). TYPHOON_KEY is also accepted.
TYPHOON_API_KEY=
# Gemini (PDF OCR)
GEMINI_API_KEY=

# Optional tuning
# WHISPER_MODEL=medium
# ANSWER_CONCURRENCY=4
# LLM_TIMEOUT_SECONDS=120
# MAX_UPLOAD_MB=25
# SESSION_TTL_SECONDS=600
# RELOAD=1            # uvicorn auto-reload (development only)
